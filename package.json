{
  "name": "octant-typology",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "A derived typology instrument: sixteen circuits, 256 relations, and network composition.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc -b --noEmit",
    "deploy": "npm run build && wrangler deploy",
    "cf:login": "wrangler login",
    "cf:whoami": "wrangler whoami",
    "lint": "biome lint ."
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-router": "^8.3.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "@cloudflare/vitest-pool-workers": "^0.20.1",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "jsdom": "^30.0.1",
    "react-dom": "^19.2.8",
    "typescript": "^6.0.3",
    "vite": "^8.2.0",
    "vitest": "^4.1.10",
    "wrangler": "^4.118.0"
  }
}
